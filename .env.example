# ─────────────────────────────────────────────────────────────
#  jw_social_downloader — пример конфигурации / example config
#  Скопируйте в .env и заполните своими значениями:
#      cp .env.example .env
#  Файл .env в репозиторий НЕ коммитится (см. .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Telegram ──
# Токен бота от @BotFather
BOT_TOKEN=123456789:AaBbCc-replace_with_your_bot_token
# Telegram user-id администратора (число). Узнать: @userinfobot
ADMIN_ID=123456789
# Публичный @username администратора (показывается в разделе поддержки)
ADMIN_USERNAME=@your_admin_username

# ── База данных ──
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# ── Загрузчик ──
# Путь к cookies.txt (Netscape-формат) для приватного/авторизованного контента.
# Файл храните вне git (папка secrets/ игнорируется).
COOKIES_FILE=secrets/cookies.txt
# Необязательный прокси для обхода анти-бота TikTok (пусто = прямое подключение)
# TIKTOK_PROXY=http://user:pass@host:port

# ── Локальный Bot API сервер ──
# false — облако, файлы до 50 МБ, MAX_FILE_SIZE_MB выше 50 урезается
# автоматически; true — свой сервер из docker-compose.yml, файлы до
# MAX_FILE_SIZE_MB.
USE_LOCAL_BOT_API=false
# Ключи приложения с https://my.telegram.org (вкладка API development tools).
# Это ключи ПРИЛОЖЕНИЯ, не бота. Обязательны для контейнера telegram-bot-api.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Адрес локального сервера (совпадает с портом из docker-compose.yml)
# TELEGRAM_API_BASE=http://127.0.0.1:8081
# TELEGRAM_REQUEST_TIMEOUT=900
# Токен отдельного тестового бота для docker compose --profile smoke.
# Боевой токен сюда не вписывать.
# TEST_BOT_TOKEN=

# ── Файлы ──
# Папка загрузок внутри контейнера. Смонтирована с /mnt/storage и должна
# совпадать с путём, смонтированным в контейнер telegram-bot-api.
# DOWNLOAD_ROOT=/srv/jw_downloads
# MIN_FREE_DISK_GB=5
# CLEANUP_MAX_AGE_MIN=45

# ── Лимиты / цены (опционально, есть значения по умолчанию) ──
# Бесплатные скачивания за скользящие 24 часа
# FREE_DOWNLOADS_PER_DAY=3
# Потолок размера отправляемого файла. На облачном транспорте бот сам
# урежет любое значение выше 50 МБ (см. USE_LOCAL_BOT_API). Потолок 1500,
# а не 2000 (лимит --local), выведен из бюджета серверного IDLE_TIMEOUT=500с.
# MAX_FILE_SIZE_MB=1500
# DOWNLOAD_TIMEOUT=900
# Цена подписки на 30 дней в звёздах Telegram (1…10000), с автопродлением
# SUBSCRIPTION_PRICE_STARS=250
